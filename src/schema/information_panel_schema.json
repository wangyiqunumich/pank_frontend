  "expression_display": {
    "excluded_presets": [
      "historical"
    ],
    "superseded_presets": {
      "baseline": "treatments"
    },
    "row_details": false,
    "descriptions": false,
    "compact_context": {
      "GENE_DETECTED_IN__Gene__anatomical_structure": {
        "method": "Raw-count CPM",
        "data": "PanKbase V3.4 · RNA-seq · no treatment"
      },
      "GENE_ENRICHED_IN__Gene__anatomical_structure": {
        "method": "DESeq2 · cell type vs rest",
        "data": "PanKbase V3.4 · RNA-seq · no treatment"
      }
    },
    "presets": {
      "treatments": {
        "title": "Expression by condition and treatment",
        "columns": [
          "condition",
          "treatment",
          "cpm",
          "pct_expr",
          "n_donors"
        ]
      },
      "cell_type": {
        "title": "{cell} vs other cell types",
        "comparison": "cell_type",
        "columns": [
          "condition",
          "log2fc",
          "p_adj",
          "stat"
        ]
      },
      "disease": {
        "title": "Disease comparison · {cell}",
        "comparison": "disease",
        "columns": [
          "condition",
          "reference_condition",
          "treatment",
          "log2fc",
          "p_adj",
          "stat"
        ]
      },
      "native": {
        "title": "RUV-normalized expression · source samples",
        "table_id": "ruv",
        "fixed_filters": {
          "record_kind": "ruv_abundance",
          "normalization": "RUVSeq_native_export"
        },
        "columns": [
          "sample_id",
          "condition",
          "treatment",
          "expression_value"
        ]
      },
      "reference": {
        "title": "RUV-normalized expression · contrast reference",
        "table_id": "ruv",
        "fixed_filters": {
          "record_kind": "ruv_abundance",
          "normalization": "RUVSeq_contrast_specific_reference"
        },
        "columns": [
          "sample_id",
          "condition",
          "reference_condition",
          "treatment",
          "expression_value"
        ]
      }
    }
  },
